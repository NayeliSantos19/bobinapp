# Copia este archivo como .env y ajusta los valores
DATABASE_URL=postgres://bobinapp:bobinapp@localhost:5432/bobinapp
PORT=3000
# Pon true si la base exige conexión cifrada (Neon, Supabase, URL externa de Render)
DATABASE_SSL=false

# Solo para el escáner de razas. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo con visión que se usará para identificar razas
ANTHROPIC_MODEL=claude-sonnet-4-5
