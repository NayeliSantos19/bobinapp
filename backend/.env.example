# Copia este archivo como .env y ajusta los valores
DATABASE_URL=postgres://bobinapp:bobinapp@localhost:5432/bobinapp
PORT=3000
# Pon true si la base exige conexión cifrada (Neon, Supabase, URL externa de Render)
DATABASE_SSL=false

# Solo para el escáner de razas. Consíguela en https://console.anthropic.com
ANTHROPIC_API_KEY=
# Modelo con visión que se usará para identificar razas
ANTHROPIC_MODEL=claude-sonnet-4-5

# Clave para ver el resumen de analítica: GET /api/telemetria/resumen con 'Authorization: Bearer <clave>'
# Genera una larga, por ejemplo con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=
